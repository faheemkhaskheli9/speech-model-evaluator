{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SME: assemble dataset",
      "type": "debugpy",
      "request": "launch",
      "module": "sme.cli",
      "args": ["--audio-dir", "examples/audio", "--out", "data/dataset"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "SME: pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
